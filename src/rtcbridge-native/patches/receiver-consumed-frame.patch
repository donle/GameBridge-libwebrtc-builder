+void RtpVideoStreamReceiver2::FrameConsumed(int64_t last_seq_num,
+                                           uint64_t epoch) {
+  RTC_DCHECK_RUN_ON(worker_queue_);
+  if (epoch != consumed_frame_epoch_ || !newest_media_seq_num_ ||
+      last_seq_num > *newest_media_seq_num_)
+    return;
+  // The original complete frame was accepted by an encoded-only consumer.
+  // Retire only through that frame, as FrameDecoded does for the decode path.
+  // Newer partial packets remain recoverable; no decode/reference/NACK state
+  // is advanced, and an old acknowledgement cannot move ClearTo backwards.
+  packet_buffer_.ClearTo(last_seq_num);
+}
