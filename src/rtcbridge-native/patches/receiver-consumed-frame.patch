+void RtpVideoStreamReceiverFrameTransformerDelegate::OnFrameConsumed(
+    std::unique_ptr<TransformableFrameInterface> frame) {
+  scoped_refptr<RtpVideoStreamReceiverFrameTransformerDelegate> delegate(this);
+  network_thread_->PostTask(
+      [delegate = std::move(delegate), frame = std::move(frame)]() mutable {
+        delegate->FrameConsumed(std::move(frame));
+      });
+}
+
+void RtpVideoStreamReceiverFrameTransformerDelegate::FrameConsumed(
+    std::unique_ptr<TransformableFrameInterface> frame) {
+  RTC_DCHECK_RUN_ON(&network_sequence_checker_);
+  if (!receiver_ || !frame || frame->GetDirection() !=
+          TransformableFrameInterface::Direction::kReceiver)
+    return;
+  auto* received = static_cast<TransformableVideoReceiverFrame*>(frame.get());
+  // Unlike transformed frames, consumed acknowledgements must never be rebased
+  // from a different receiver. Reset also invalidates outstanding callbacks.
+  if (received->Receiver() == receiver_)
+    received->Consume();
+}
