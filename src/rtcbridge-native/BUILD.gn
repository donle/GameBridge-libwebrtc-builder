import("//webrtc.gni")

config("bridge_config") {
  include_dirs = [
    "include",
    "src",
    "../rtcbridge/include",
  ]
  defines = [
    "NOMINMAX",
    "WIN32_LEAN_AND_MEAN",
  ]
  cflags_cc = [ "/EHsc" ]
}

foreach(variant,
        [
          "gamebridge_rtc",
          "gamebridge_rtc_probe",
          "gamebridge_rtc_bench",
        ]) {
  shared_library(variant) {
    sources = [ "src/bridge.cpp" ]
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [
      "//build/config/compiler:exceptions",
      "//:common_config",
      ":bridge_config",
    ]
    if (variant == "gamebridge_rtc_probe") {
      defines = [ "GB_RTC_TESTING" ]
    }
    if (variant == "gamebridge_rtc_bench") {
      defines = [ "GB_RTC_BENCH" ]
    }
    deps = [
      "//api:candidate",
      "//api:create_peerconnection_factory",
      "//api:frame_transformer_factory",
      "//api:make_ref_counted",
      "//api:peer_connection_interface",
      "//api:rtc_stats_api",
      "//api:rtp_parameters",
      "//api/audio:create_audio_device_module",
      "//api/audio_codecs:builtin_audio_decoder_factory",
      "//api/audio_codecs:builtin_audio_encoder_factory",
      "//api/environment:environment_factory",
      "//api/video_codecs:builtin_video_decoder_factory",
      "//api/video_codecs:builtin_video_encoder_factory",
      "//rtc_base:logging",
      "//rtc_base:ssl",
      "//rtc_base:threading",
      "//rtc_base:win32_socket_init",
    ]
  }
}

executable("rtc_native_core_tests") {
  sources = [ "tests/core_tests.cpp" ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [
    "//build/config/compiler:exceptions",
    ":bridge_config",
  ]
  libs = [ "ws2_32.lib" ]
}

executable("rtc_injector_cold_start_tests") {
  sources = [ "tests/injector_cold_start_tests.cpp" ]
  configs += [ ":bridge_config" ]
}

executable("rtc_runtime_socket_tests") {
  sources = [ "tests/runtime_socket_tests.cpp" ]
  configs += [
    "//:common_config",
    ":bridge_config",
  ]
  deps = [ "//rtc_base:win32_socket_init" ]
  libs = [ "ws2_32.lib" ]
}

executable("rtc_connection_diagnostics_tests") {
  sources = [ "tests/connection_diagnostics_tests.cpp" ]
  include_dirs = [ "../native/tests" ]
  configs += [ ":bridge_config" ]
}

# Keep the production codec's installed-header include spelling while using
# only the headers and library from the pinned upstream Opus dependency.
copy("rtc_abi_opus_headers") {
  sources = [
    "//third_party/opus/src/include/opus.h",
    "//third_party/opus/src/include/opus_defines.h",
    "//third_party/opus/src/include/opus_types.h",
  ]
  outputs = [ "$target_gen_dir/opus/{{source_file_part}}" ]
}

executable("rtc_abi_tests") {
  sources = [
    "../native/tests/rtc_abi_c_layout.c",
    "../native/tests/rtc_abi_tests.cpp",
    "../native/src/audio/audio_clock.cpp",
    "../native/src/audio/opus_codec.cpp",
  ]
  include_dirs = [ "../native/include", target_gen_dir ]
  deps = [ ":rtc_abi_opus_headers", "//third_party/opus" ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [
    "//build/config/compiler:exceptions",
    ":bridge_config",
  ]
}

executable("rtc_bridge_bench") {
  sources = [ "../native/bench/rtc_bridge_bench.cpp" ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [
    "//build/config/compiler:exceptions",
    ":bridge_config",
  ]
  libs = [
    "psapi.lib",
    "winmm.lib",
  ]
}

executable("rtc_bench_diagnostics_tests") {
  sources = [ "tests/bench_diagnostics_tests.cpp" ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [
    "//build/config/compiler:exceptions",
    ":bridge_config",
  ]
  libs = [ "psapi.lib" ]
}

executable("rtc_transport_diagnostics_tests") {
  sources = [ "tests/transport_diagnostics_tests.cpp" ]
  configs += [ ":bridge_config" ]
}

executable("rtc_sender_bitrate_tests") {
  sources = [ "tests/sender_bitrate_tests.cpp" ]
  configs += [ ":bridge_config" ]
}

executable("rtc_sender_pacer_tests") {
  sources = [ "tests/sender_pacer_tests.cpp" ]
  configs += [
    "//:common_config",
    ":bridge_config",
  ]
  deps = [
    "//api:field_trials_view",
    "//api/transport:network_control",
    "//api/units:data_rate",
    "//api/units:data_size",
    "//api/units:time_delta",
    "//api/units:timestamp",
    "//modules/pacing",
    "//modules/rtp_rtcp:rtp_rtcp_format",
    "//system_wrappers",
  ]
}

group("all") {
  deps = [
    ":gamebridge_rtc",
    ":gamebridge_rtc_bench",
    ":gamebridge_rtc_probe",
    ":rtc_abi_tests",
    ":rtc_bench_diagnostics_tests",
    ":rtc_bridge_bench",
    ":rtc_connection_diagnostics_tests",
    ":rtc_injector_cold_start_tests",
    ":rtc_native_core_tests",
    ":rtc_runtime_socket_tests",
    ":rtc_sender_bitrate_tests",
    ":rtc_sender_pacer_tests",
    ":rtc_transport_diagnostics_tests",
  ]
}
